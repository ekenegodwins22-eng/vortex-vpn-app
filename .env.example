# Vortex Shield VPN - Environment Configuration

# Backend API URL
REACT_APP_API_URL=https://vortex-vpn-backend-production.up.railway.app

# App Version
REACT_APP_VERSION=1.0.0

# App Name
REACT_APP_NAME=Vortex Shield VPN

# Package Name (Android)
PACKAGE_NAME=com.vortexvpn.app

# Bundle ID (iOS)
BUNDLE_ID=com.vortexvpn.app

# Build Type
BUILD_TYPE=debug

# Environment
NODE_ENV=production

# Logging
LOG_LEVEL=info

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false

# VPN Configuration
DEFAULT_PROTOCOL=WireGuard
DEFAULT_CARRIER=All
AUTO_CONNECT=false

# Security
ENABLE_KILL_SWITCH=true
ENABLE_DNS_LEAK_PROTECTION=true
ENABLE_IPV6_LEAK_PROTECTION=true
